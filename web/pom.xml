<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Build logic and versions come from shared-build, through the root pom. -->
    <parent>
        <groupId>com.example</groupId>
        <artifactId>servlet-example-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>servlet-example</artifactId>
    <packaging>jar</packaging>

    <name>Jakarta EE Servlet Example</name>
    <description>Simple web application using Jakarta EE Servlets with Embedded Tomcat</description>

    <properties>
        <!-- Read by the shade and exec conventions in shared-build -->
        <app.mainClass>com.example.Main</app.mainClass>
        <!-- Only web starts a server; other modules skip exec in dev mode -->
        <exec.skip>false</exec.skip>
    </properties>

    <!--
        No versions here by design. Every version is pinned in
        shared-build/catalog. To add a library, add it to that catalog first.
    -->
    <dependencies>
        <!-- App modules -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>servlet-example-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>servlet-example-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>servlet-example-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>servlet-example-databrowser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>servlet-example-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Embedded Tomcat -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
        </dependency>

        <!-- Gson for JSON processing -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- Mozilla Rhino for JavaScript execution -->
        <dependency>
            <groupId>org.mozilla</groupId>
            <artifactId>rhino</artifactId>
        </dependency>

        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- jOOQ - type-safe SQL DSL -->
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito for mocking in tests -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit for layer rules -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Opting in to two conventions. Versions and configuration come from
            shared-build; this project only says that it wants them.
        -->
        <plugins>
            <!-- Executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>

            <!-- Dev server: mvn -PappRun -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>